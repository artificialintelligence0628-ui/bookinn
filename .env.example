# --- Database ---
# Postgres connection string. Get one free from Neon (neon.tech): create a
# project, then copy the "Connection string" shown on the dashboard — it
# looks like postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Existing app secrets
# REQUIRED in production — must be a real random string (not the placeholder
# below). Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

RESEND_API_KEY=re_your_key_here
FRONTEND_URL=https://bookinngh.com
EMAIL_FROM=BookInn <noreply@bookinngh.com>

# Optional — only needed if you want real Delivered/Opened/Clicked/Bounced
# analytics in the Email Center. Configure a webhook in the Resend dashboard
# pointing to https://bookinngh.com/api/webhooks/resend, then paste the
# signing secret it gives you here. Without this, campaigns still send and
# record "sent"/"failed" correctly — you just won't get delivery/open/click
# tracking from Resend.
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# --- Google sign-in (optional) ---
# "Continue with Google" on the login/signup screen. Create an OAuth client of
# type "Web application" at console.cloud.google.com > APIs & Services >
# Credentials, and add your site (https://bookinngh.com and http://localhost:5173)
# under "Authorized JavaScript origins". The same ID goes in both variables:
# GOOGLE_CLIENT_ID is read by the server to verify tokens, VITE_GOOGLE_CLIENT_ID
# is baked into the frontend at build time. Leave both unset to hide the button.
GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# --- Platform admin account ---
# Seeded automatically the first time the server starts (only if no Admin account
# exists yet). REQUIRED in production — the server refuses to start if these are
# left unset or still equal to the placeholder values below. Pick your own real
# email and a strong password (12+ characters) before deploying anywhere public.
ADMIN_EMAIL=your-real-admin-email@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# --- NODE_ENV ---
# Set this to "production" on Render (or your host) — it turns on the startup
# guard above that refuses to boot with placeholder/default secrets.
NODE_ENV=production
