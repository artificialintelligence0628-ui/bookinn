# Copy this file to .env and fill in your real Paystack keys.
# Get both keys from the Paystack dashboard: Settings > API Keys & Webhooks.
# Use the "test" keys while developing, and switch to "live" keys in production.

# --- Frontend (Vite) ---
# Public key — safe to expose in the browser. Vite only exposes vars
# prefixed with VITE_ to client code.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Backend (server/index.js) ---
# Secret key — NEVER expose this in the browser or commit it. Used to
# verify payments server-side after Paystack's popup reports success.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Database ---
# Postgres connection string. Get one free from Neon (neon.tech): create a
# project, then copy the "Connection string" shown on the dashboard — it
# looks like postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Existing app secrets
JWT_SECRET=change-me-to-a-long-random-string
PORT=4000

RESEND_API_KEY=re_your_key_here
FRONTEND_URL=https://bookinngh.com
EMAIL_FROM=BookInn <noreply@bookinngh.com>

# Optional — only needed if you want real Delivered/Opened/Clicked/Bounced
# analytics in the Email Center. Configure a webhook in the Resend dashboard
# pointing to https://bookinngh.com/api/webhooks/resend, then paste the
# signing secret it gives you here. Without this, campaigns still send and
# record "sent"/"failed" correctly — you just won't get delivery/open/click
# tracking from Resend.
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret_here

# --- Platform admin account ---
# Seeded automatically the first time the server starts (only if no Admin account
# exists yet in server/data/db.json). Change these before deploying anywhere public.
ADMIN_EMAIL=bookinn@gmail.com
ADMIN_PASSWORD=BBII88@.com
